# Адрес API вместе с версией. Локально бекенд (orenza-backend) поднимается
# в docker на APP_PORT=8080, поэтому по умолчанию — http://localhost:8080/api/v1.
#
# Если фронтенд раздаётся с того же домена, что и API, оставьте относительный
# путь: VITE_API_URL=/api/v1
VITE_API_URL=http://localhost:8080/api/v1
